# ── D5 Security Layer — Environment Template ────────────────────────────────
# Copy to .env and fill in values. NEVER commit .env.

# App
APP_NAME=SECURITY LAYER
VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
# "true" renders human-readable console logs (dev); "false" renders JSON (prod)
DEV=false

# Database
# Dev:  sqlite+aiosqlite:///./d5_dev.db
# Prod: postgresql+asyncpg://user:pass@host:5432/d5
DATABASE_URL=sqlite+aiosqlite:///./d5_dev.db
# Create tables on startup (dev convenience). Set false in prod — use alembic.
DB_AUTO_CREATE=true

# Security — JWT (RS256)
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRE_MINUTE=15
JWT_REFRESH_EXPIRE_DAYS=7
# Provisioned key files (mounted secret in prod; never auto-generated there)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
# CORS allowlist, comma-separated (e.g. "https://app.example.com")
CORS_ALLOW_ORIGINS=

# Auth bootstrap (used by scripts/seed_users.py)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_ORG=org_uma

# LangSmith (unused until observability phase)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=d5-poc

# Guardrails
GUARDRAIL_TOPIC_MODE=warn
GUARDRAIL_LANGUAGE_MODE=warn
GUARDRAIL_MAX_INPUT_BYTES=32768
GUARDRAIL_ENCODED_PAYLOAD_BLOCK=true
# Deny requests that omit explicit consent_granted=true
GUARDRAIL_CONSENT_DEFAULT_GRANTED=false
# Max request body size in bytes (server-level cap)
MAX_REQUEST_BODY_BYTES=65536

# LLM-based Guardrail (Layer 5)
LLM_GUARDRAIL_ENABLED=true
LLM_GUARDRAIL_PROVIDER=gemini
LLM_GUARDRAIL_API_KEY=
LLM_GUARDRAIL_MODEL=gemini-3.1-flash-lite
LLM_GUARDRAIL_MODE=block
LLM_GUARDRAIL_TIMEOUT_SEC=2.0

# Presidio PII/PHI Engine
PRESIDIO_ENABLED=true
PRESIDIO_NLP_MODEL=en_core_web_lg
PRESIDIO_MIN_SCORE=0.6
PRESIDIO_ANONYMIZER_MODE=replace

# D3 Egress — timeout, retry, circuit breaker
D3_TIMEOUT_SEC=5.0
D3_MAX_RETRIES=2
D3_RETRY_BASE_DELAY_SEC=0.25
D3_CIRCUIT_FAILURE_THRESHOLD=5
D3_CIRCUIT_RESET_SEC=30.0
